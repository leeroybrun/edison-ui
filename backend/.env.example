# Edison UI Backend Configuration Example
# Copy this file to .env and update values

# Edison Integration
EDISON_PATH=/path/to/edison
EDISON_PROJECTS_ROOT=/Users/your-username/projects

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
