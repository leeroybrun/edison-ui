# Edison UI Backend Configuration Example
# Copy this file to .env and update values

# =============================================================================
# Edison Integration
# =============================================================================

# Path to Edison installation (for editable install)
# EDISON_PATH=/path/to/edison

# =============================================================================
# Project Discovery (Scan Roots)
# =============================================================================

# Comma-separated list of directories to scan for Edison projects
# Default: ~/projects
# Example: ~/projects,~/work,/opt/company-projects
SCAN_ROOTS=~/projects

# Comma-separated glob patterns to ignore during discovery
# Default: node_modules,.git,.venv,__pycache__
SCAN_IGNORE_PATTERNS=node_modules,.git,.venv,__pycache__

# =============================================================================
# Exposure Mode (Security)
# =============================================================================

# Server exposure mode: "localhost" or "exposed"
# - localhost: Binds to 127.0.0.1 only (default, no auth required)
# - exposed: Binds to 0.0.0.0, requires pairing/auth for remote access
# Default: localhost
EXPOSURE_MODE=localhost

# =============================================================================
# Realtime Updates
# =============================================================================

# Enable realtime push updates via WebSocket
# Default: true
REALTIME_ENABLED=true

# Enable filesystem watchers for automatic refresh
# Default: true (falls back to polling if unavailable)
REALTIME_WATCHER_ENABLED=true

# Polling interval in milliseconds (fallback when watchers unavailable)
# Default: 5000 (5 seconds)
REALTIME_POLLING_INTERVAL_MS=5000

# =============================================================================
# API Configuration
# =============================================================================

# Server host and port
# Note: Use 127.0.0.1 for localhost mode, 0.0.0.0 for exposed mode
API_HOST=127.0.0.1
API_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# Environment
# =============================================================================

# Environment: development, production
ENVIRONMENT=development

# Enable debug mode
DEBUG=true

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
