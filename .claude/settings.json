{
  "cleanupPeriodDays": 120,
  "enableAllProjectMcpServers": true,
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/leeroy/Documents/Development/edison-ui/.claude/hooks/auto-format.sh",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "/Users/leeroy/Documents/Development/edison-ui/.claude/hooks/compaction-reminder.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/leeroy/Documents/Development/edison-ui/.claude/hooks/remind-tdd.sh",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "command": "/Users/leeroy/Documents/Development/edison-ui/.claude/hooks/commit-guard.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash(git commit:*)"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "/Users/leeroy/Documents/Development/edison-ui/.claude/hooks/session-cleanup.sh",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/Users/leeroy/Documents/Development/edison-ui/.claude/hooks/session-init.sh",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "/Users/leeroy/Documents/Development/edison-ui/.claude/hooks/subagent-start-logger.sh",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/Users/leeroy/Documents/Development/edison-ui/.claude/hooks/subagent-stop-logger.sh",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/Users/leeroy/Documents/Development/edison-ui/.claude/hooks/inject-session-context.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/Users/leeroy/Documents/Development/edison-ui/.claude/hooks/inject-task-rules.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(touch:*)",
      "Bash(pwd:*)",
      "WebSearch",
      "WebFetch",
      "Glob(./**)",
      "Grep(./**)",
      "Bash(edison:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(python -m mypy:*)",
      "Bash(python3 -m mypy:*)",
      "Bash(mypy:*)",
      "Bash(python -m ruff:*)",
      "Bash(python3 -m ruff:*)",
      "Bash(ruff:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm exec:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(tsc:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(next:*)",
      "Bash(pnpm next:*)",
      "Bash(npx next:*)",
      "Bash(tailwindcss:*)",
      "Bash(pnpm tailwindcss:*)",
      "Bash(npx tailwindcss:*)",
      "Bash(vitest:*)",
      "Bash(pnpm vitest:*)",
      "Bash(npx vitest:*)",
      "Bash(playwright:*)",
      "Bash(pnpm playwright:*)",
      "Bash(npx playwright:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(docker push:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Edit(./.env*)",
      "Write(./.env*)",
      "Bash(sudo:*)",
      "Bash(rm -rf /:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)"
    ]
  }
}