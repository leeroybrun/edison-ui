{
  "name": "edison-ui-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Modern web dashboard for Edison project management",
  "pnpm": {
    "overrides": {
      "glob@>=10.2.0 <10.5.0": ">=10.5.0"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
